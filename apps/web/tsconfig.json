{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "incremental": true,
    "outDir": "dist",
    "moduleResolution": "bundler",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@smart-pantry/ui": ["../../packages/ui-web/src/index.ts"],
      "@smart-pantry/ui/*": ["../../packages/ui-web/src/*"],
      "@db/*": ["../../packages/db/src/*"],
      "@trpc/*": ["../../packages/trpc/src/*"],
      "@ai/*": ["../../packages/ai/src/*"],
      "@types/*": ["../../packages/types/src/*"],
      "@config/*": ["../../packages/config/src/*"]
    },
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.cjs",
    "**/*.js",
    ".next/types/**/*.ts",
    "src"
, "postcss.config.mjs"  ],
  "exclude": [
    "node_modules"
  ]
}
