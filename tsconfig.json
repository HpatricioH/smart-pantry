{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@db/*": ["packages/db/src/*"],
      "@trpc/*": ["packages/trpc/src/*"],
      "@ai/*": ["packages/ai/src/*"],
      "@smart-pantry/ui": ["packages/ui-web/src/index.ts"],
      "@smart-pantry/ui/*": ["packages/ui-web/src/*"],
      "@smart-pantry/types": ["packages/types/src/index.ts"],
      "@smart-pantry/types/*": ["packages/types/src/*"],
      "@smart-pantry/queries": ["packages/db/src/index.ts"],
      "@config/*": ["packages/config/src/*"]
    },
    "moduleResolution": "node",
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "ESNext"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": false
  }
}
